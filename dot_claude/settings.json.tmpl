{{- /*
Orca rewrites its own hook entries in ~/.claude/settings.json on every update.
To keep them out of the repository, the hooks below come from claude-hooks.json.tmpl
plus the hook groups that Orca already installed in the destination file.
*/ -}}
{{- $hooks := includeTemplate "claude-hooks.json.tmpl" . | fromJson -}}
{{- $dest := joinPath .chezmoi.homeDir ".claude/settings.json" -}}
{{- if stat $dest -}}
{{-   range $event, $groups := (include $dest | fromJson).hooks -}}
{{-     range $group := $groups -}}
{{-       $isOrca := false -}}
{{-       range $group.hooks -}}
{{-         $command := .command | default "" -}}
{{-         if or (contains "ORCA_AGENT_HOOK" $command) (contains ".orca/agent-hooks" $command) -}}
{{-           $isOrca = true -}}
{{-         end -}}
{{-       end -}}
{{-       if $isOrca -}}
{{-         $hooks = set $hooks $event (append (get $hooks $event | default (list)) $group) -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "300000",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_THRIFTY_SONIC": "false",
    "JJ_EDITOR": "false"
  },
  "permissions": {
    "allow": [
      "Glob",
      "Grep",
      "Read",
{{- range $.agentWritePaths }}
      "Edit({{ joinPath $.chezmoi.homeDir . }}/**)",
{{- end }}
      "Bash({{ env "HOME" }}/.agents/skills/spec-implementation-check/spec-scope-check.sh:*)",
      "Bash(cat:*)",
      "Bash(chezmoi *)",
      "Bash(echo:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(jj bookmark:*)",
      "Bash(jj config:*)",
      "Bash(jj describe:*)",
      "Bash(jj diff:*)",
      "Bash(jj evolog:*)",
      "Bash(jj file list:*)",
      "Bash(jj file show:*)",
      "Bash(jj help:*)",
      "Bash(jj interdiff:*)",
      "Bash(jj log:*)",
      "Bash(jj new:*)",
      "Bash(jj op log:*)",
      "Bash(jj root:*)",
      "Bash(jj show:*)",
      "Bash(jj status:*)",
      "Bash(jj version:*)",
      "WebFetch(domain:caniuse.com)",
      "WebFetch(domain:dev.to)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:qiita.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:stackoverflow.com)",
      "WebFetch(domain:zenn.dev)",
      "mcp__Figma__get_metadata",
      "mcp__Figma__get_screenshot",
      "mcp__Figma__use_figma",
      "mcp__claude_ai_Figma__get_screenshot",
      "mcp__claude_ai_Figma__get_metadata",
      "mcp__claude_ai_Figma__use_figma",
      "mcp__plugin_figma_figma__get_metadata",
      "mcp__plugin_figma_figma__get_screenshot",
      "mcp__plugin_figma_figma__use_figma"
    ],
    "deny": [
{{- range $.agentReadOnlyPaths }}
      "Edit({{ joinPath $.chezmoi.homeDir . }}/**)",
{{- end }}
      "NotebookEdit",
      "Bash(git clean:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Bash(git gc:*)",
      "Bash(git merge:*)",
      "Bash(git reset:*)",
      "Bash(git rm:*)",
      "Bash(jj file untrack:*)",
      "Bash(jj git push:*)",
      "Bash(npm publish)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {{ $hooks | toPrettyJson | replace "\n" "\n  " }},
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "chrome-devtools-mcp@chrome-devtools-plugins": true,
    "anti-slop-code@kubosho-skills": true,
    "anti-slop-comment@kubosho-skills": true,
    "baseline@kubosho-skills": true,
    "test-principles@kubosho-skills": true,
    "skill-creator@claude-plugins-official": true,
    "codex@openai-codex": true,
    "figma@claude-plugins-official": true,
    "a11y-specialist-skills@a11y-specialist-skills": true,
    "security-guidance@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "i-have-adhd@i-have-adhd": true,
    "explainer@explainer": true,
    "cache-tools@claude-code-cache-tools": true,
    "spec-driven-development@kubosho-skills": true
  },
  "extraKnownMarketplaces": {
    "kubosho-skills": {
      "source": {
        "source": "github",
        "repo": "kubosho/my-skills"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "a11y-specialist-skills": {
      "source": {
        "source": "github",
        "repo": "masuP9/a11y-specialist-skills"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    },
    "explainer": {
      "source": {
        "source": "github",
        "repo": "mizchi/explainer"
      }
    },
    "claude-code-cache-tools": {
      "source": {
        "source": "github",
        "repo": "Sigsiguma/claude-code-cache-tools"
      }
    }
  },
  "outputStyle": "篠澤広",
  "language": "日本語",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowedDomains": [
        "api.github.com",
        "github.com",
        "raw.githubusercontent.com",
        "registry.npmjs.org",
        "nodejs.org",
        "dev.to",
        "qiita.com",
        "zenn.dev"
      ],
      "allowUnixSockets": [
        "{{ joinPath $.chezmoi.homeDir ".config/herdr/herdr.sock" }}",
        "{{ joinPath $.chezmoi.homeDir "Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh" }}"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
{{- range $i, $p := $.agentWritePaths }}{{ if $i }},{{ end }}
        "{{ joinPath $.chezmoi.homeDir $p }}"
{{- end }}
      ],
      "denyWrite": [
{{- range $i, $p := $.agentReadOnlyPaths }}{{ if $i }},{{ end }}
        "{{ joinPath $.chezmoi.homeDir $p }}"
{{- end }}
      ]
    },
    "excludedCommands": [
      "chezmoi apply:*",
      "gh issue list:*",
      "gh issue status:*",
      "gh issue view:*",
      "gh label list:*",
      "gh pr checks:*",
      "gh pr close:*",
      "gh pr diff:*",
      "gh pr list:*",
      "gh pr status:*",
      "gh pr view:*",
      "gh release list:*",
      "gh release view:*",
      "gh repo view:*",
      "gh run list:*",
      "gh run view:*",
      "gh search:*",
      "gh workflow list:*",
      "gh workflow view:*",
      "git commit:*",
      "herdr:*",
      "jj:*",
      "mani:*"
    ]
  },
  "promptSuggestionEnabled": false,
  "pluginConfigs": {
    "cache-tools@claude-code-cache-tools": {
      "options": {
        "cacheTtlWatch": true,
        "cacheGuard": true,
        "cacheGuardMode": "compact",
        "cacheGuardAtPercent": 90
      }
    }
  },
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "theme": "light",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(jj status:*)",
      "Bash(jj log:*)",
      "Bash(jj diff:*)",
      "Bash(chezmoi diff:*)",
      "Bash(chezmoi status:*)"
    ],
    "soft_deny": [
      "$defaults",
      "Bash(chezmoi apply:*)",
      "Bash(jj abandon:*)",
      "Bash(jj op restore:*)"
    ]
  }
}
