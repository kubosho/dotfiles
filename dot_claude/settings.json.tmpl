{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_THRIFTY_SONIC": "false",
    "JJ_EDITOR": "false"
  },
  "permissions": {
    "allow": [
      "Glob",
      "Grep",
      "Read",
{{- range $.agentWritePaths }}
      "Edit({{ joinPath $.chezmoi.homeDir . }}/**)",
{{- end }}
      "Bash({{ env "HOME" }}/.agents/skills/spec-implementation-check/spec-scope-check.sh:*)",
      "Bash(cat:*)",
      "Bash(chezmoi *)",
      "Bash(echo:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(jj bookmark:*)",
      "Bash(jj config:*)",
      "Bash(jj describe:*)",
      "Bash(jj diff:*)",
      "Bash(jj evolog:*)",
      "Bash(jj file list:*)",
      "Bash(jj file show:*)",
      "Bash(jj help:*)",
      "Bash(jj interdiff:*)",
      "Bash(jj log:*)",
      "Bash(jj new:*)",
      "Bash(jj op log:*)",
      "Bash(jj root:*)",
      "Bash(jj show:*)",
      "Bash(jj status:*)",
      "Bash(jj version:*)",
      "WebFetch(domain:caniuse.com)",
      "WebFetch(domain:dev.to)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:qiita.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:stackoverflow.com)",
      "WebFetch(domain:zenn.dev)"
    ],
    "deny": [
{{- range $.agentReadOnlyPaths }}
      "Edit({{ joinPath $.chezmoi.homeDir . }}/**)",
{{- end }}
      "NotebookEdit",
      "Bash(dotenvx get)",
      "Bash(git clean:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Bash(git gc:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git rm:*)",
      "Bash(jj file untrack:*)",
      "Bash(jj git push:*)",
      "Bash(npm publish)",
      "Bash(op read)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/jj-session-start.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/vcs-overview-session-start.sh"
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
