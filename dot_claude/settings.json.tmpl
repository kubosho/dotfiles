{{- if ne .chezmoi.hostname "local" }}
  "deniedMcpServers": [
    {
      "serverUrl": "https://mcp.atlassian.com/*"
    }
  ],
{{- end }}
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "chrome-devtools-mcp@chrome-devtools-plugins": true,
    "anti-slop-code@kubosho-skills": true,
    "anti-slop-comment@kubosho-skills": true,
    "baseline@kubosho-skills": true,
    "test-principles@kubosho-skills": true,
    "skill-creator@claude-plugins-official": true,
    "codex@openai-codex": true,
    "figma@claude-plugins-official": true,
    "a11y-specialist-skills@a11y-specialist-skills": true,
    "security-guidance@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "i-have-adhd@i-have-adhd": true
  },
  "extraKnownMarketplaces": {
    "kubosho-skills": {
      "source": {
        "source": "github",
        "repo": "kubosho/my-skills"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "a11y-specialist-skills": {
      "source": {
        "source": "github",
        "repo": "masuP9/a11y-specialist-skills"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    }
  },
  "outputStyle": "篠澤広",
  "language": "日本語",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "filesystem": {
      "allowWrite": [
{{- range $i, $p := $.agentWritePaths }}{{ if $i }},{{ end }}
        "{{ joinPath $.chezmoi.homeDir $p }}"
{{- end }}
      ],
      "denyWrite": [
{{- range $i, $p := $.agentReadOnlyPaths }}{{ if $i }},{{ end }}
        "{{ joinPath $.chezmoi.homeDir $p }}"
{{- end }}
      ]
    },
    "network": {
      "allowedDomains": [
        "api.github.com",
        "github.com",
        "raw.githubusercontent.com",
        "registry.npmjs.org",
        "nodejs.org",
        "dev.to",
        "qiita.com",
        "zenn.dev"
      ]
    },
    "excludedCommands": [
      "chezmoi apply:*",
      "gh issue list:*",
      "gh issue view:*",
      "gh pr checks:*",
      "gh pr close:*",
      "gh pr diff:*",
      "gh pr list:*",
      "gh pr status:*",
      "gh pr view:*",
      "git commit:*",
      "herdr:*",
      "jj:*",
      "mani:*"
    ]
  },
  "promptSuggestionEnabled": false,
  "advisorModel": "fable",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "theme": "light",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(jj status:*)",
      "Bash(jj log:*)",
      "Bash(jj diff:*)",
      "Bash(chezmoi diff:*)",
      "Bash(chezmoi status:*)"
    ],
    "soft_deny": [
      "$defaults",
      "Bash(chezmoi apply:*)",
      "Bash(jj abandon:*)",
      "Bash(jj op restore:*)"
    ]
  }
}
