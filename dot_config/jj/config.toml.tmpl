{{- $gitconfigUserItem := ".gitconfig-user" -}}
{{- if hasKey . "gitconfigUserItem" }}{{ $gitconfigUserItem = .gitconfigUserItem }}{{ end -}}
{{- $gitUser := (onepasswordRead (printf "op://Development/%s/notesPlain" $gitconfigUserItem) | fromIni).user -}}
[user]
name = {{ $gitUser.name | quote }}
email = {{ $gitUser.email | quote }}

[colors]
"diff removed token" = { bg = "#feca8b", underline = false }
"diff added token" = { bg = "#83cbec", underline = false }

[signing]
behavior = "drop"
backend = "ssh"
key = {{ $gitUser.signingkey | quote }}

[signing.backends.ssh]
allowed-signers = {{ joinPath .chezmoi.homeDir ".gitallowedsigners" | quote }}

[git]
sign-on-push = true

[snapshot]
auto-update-stale = true
max-new-file-size = "5MiB"
